  "info": {
    "_postman_id": "548d6a0a-d88a-4dd0-a0ee-a70ef54c3f06",
    "name": "Lunar.dev Gateway Admin API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Lunar.dev Gateway Admin API provides administrative endpoints for managing and monitoring the Lunar API Consumption Gateway. The gateway acts as an egress proxy for third-party API traffic, providing visibility, control, and performance optimization. The admin API enables health monitoring, endpoint discovery, flow validation, and policy management for the running gateway instance.\n\nContact Support:\n Name: Lunar.dev",
      "type": "text/plain"
    }
  }
