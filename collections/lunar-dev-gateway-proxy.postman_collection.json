  "info": {
    "_postman_id": "856ef639-5cae-4a52-8bec-8328db7b85a7",
    "name": "Lunar.dev Gateway Proxy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Lunar.dev Gateway Proxy API handles the routing of outbound (egress) API traffic through the Lunar Gateway. Client applications send their third-party API requests through this proxy, which provides traffic management, policy enforcement, caching, rate limiting, quota management, and real-time observability. Requests are routed by specifying the target host via the x-lunar-host header, and the gateway forwards the request while applying configured flows and policies.\n\nContact Support:\n Name: Lunar.dev",
      "type": "text/plain"
    }
  }
