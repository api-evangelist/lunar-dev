      "item": [
        {
          "name": "Lunar.dev Apply policies",
          "id": "15f0c240-2b20-4b06-b7ca-ada2cc460be6",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/apply_policies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "apply_policies"
              ]
            },
            "description": "Applies the current policies configuration (policies.yaml) to the running Lunar Gateway instance. This reloads the policy definitions and activates any changes made to the policies file without requiring a gateway restart."
